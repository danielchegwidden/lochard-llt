{
  "datasets": [
    {
      "name": "usage",
      "displayName": "AI Gateway usage",
      "queryLines": [
        "SELECT usage_date, event_time, model_service, destination_model, requester, status_code, latency_ms, input_tokens,\n",
        "       output_tokens, total_tokens, experiment_arm, app, used_fallback, est_cost_usd,\n",
        "       CASE WHEN used_fallback THEN 1 ELSE 0 END AS fallback_flag,      -- flags for rate counters (no CASE in widget exprs)\n",
        "       CASE WHEN status_code >= 400 THEN 1 ELSE 0 END AS error_flag\n",
        "FROM v_ai_cost WHERE model_service LIKE 'lochard%'\n"
      ]
    },
    {
      "name": "frontier",
      "displayName": "Cost vs quality frontier",
      "queryLines": [
        "SELECT * FROM v_ai_cost_frontier\n"
      ]
    },
    {
      "name": "exp",
      "displayName": "Experiment detail",
      "queryLines": [
        "SELECT * FROM v_ai_cost_experiment\n"
      ]
    }
  ],
