{
  "datasets": [
    {
      "name": "exp",
      "displayName": "Expectations",
      "queryLines": [
        "SELECT *, concat(table_name, '.', expectation) AS rule_key, passed_records + failed_records AS total_records\n",
        "FROM v_pipeline_expectations\n"
      ]
    },
    {
      "name": "upd",
      "displayName": "Pipeline updates",
      "queryLines": [
        "SELECT *, CASE WHEN final_state = 'COMPLETED' THEN 1 ELSE 0 END AS ok_flag,\n",
        "       -- health KPI = outcome of each pipeline's most recent finished update (history stays in the table below)\n",
        "       CASE WHEN row_number() OVER (PARTITION BY pipeline, final_state IS NOT NULL ORDER BY started_at DESC) = 1\n",
        "                 AND final_state IS NOT NULL\n",
        "            THEN CASE WHEN final_state = 'COMPLETED' THEN 1 ELSE 0 END END AS latest_ok_flag\n",
        "FROM v_pipeline_updates\n"
      ]
    },
    {
      "name": "fresh",
      "displayName": "Freshness",
      "queryLines": [
        "SELECT table_name, latest_business_date, sla_days, datediff(current_date(), latest_business_date) AS age_days,\n",
        "       datediff(current_date(), latest_business_date) <= sla_days AS within_sla,\n",
        "       CASE WHEN datediff(current_date(), latest_business_date) <= sla_days THEN 1 ELSE 0 END AS sla_flag\n",
        "FROM v_table_freshness\n"
      ]
    }
  ],
