                      "name": "weekly(schedule_week_start)",
                      "expression": "DATE_TRUNC(\"WEEK\", `schedule_week_start`)"
                    },
                    {
                      "name": "sum(scheduled_count)",
                      "expression": "SUM(`scheduled_count`)"
                    },
                    {
                      "name": "sum(schedule_compliant_count)",
                      "expression": "SUM(`schedule_compliant_count`)"
