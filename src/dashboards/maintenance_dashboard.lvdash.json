{
  "datasets": [
    {
      "name": "snap",
      "displayName": "Latest weekly snapshot",
      "queryLines": [
        "SELECT snapshot_date, schedule_week_start, priority_bucket, work_type, wo_class, status, is_open, lead_craft,\n",
        "       workorder_count, scheduled_count, schedule_compliant_count, est_dur_scheduled, est_dur_compliant,\n",
        "       overdue_safety_critical_count, backlog_count,\n",
        "       CASE WHEN priority_bucket = 'P1' AND is_open THEN workorder_count ELSE 0 END AS open_p1_count,\n",
        "       CASE WHEN priority_bucket = 'P2' AND work_type <> 'PM' AND is_open THEN workorder_count ELSE 0 END AS open_p2_ex_pm_count,\n",
        "       CASE WHEN work_type <> 'PM' THEN backlog_count ELSE 0 END AS backlog_ex_pm_count\n",
        "FROM v_workorder_schedule_weekly WHERE is_latest_snapshot\n"
      ]
    },
    {
      "name": "sched",
      "displayName": "Scheduled work (13 weeks)",
      "queryLines": [
        "SELECT schedule_week_start, priority_bucket, work_type, status, lead_craft, scheduled_count, schedule_compliant_count,\n",
        "       NULLIF(scheduled_count, 0) AS scheduled_count_nz,             -- ratio denominator: never divides by zero\n",
        "       CAST(est_dur_scheduled AS DECIMAL(14, 2)) AS est_dur_scheduled,   -- exact sums (no float noise in labels)\n",
        "       CAST(est_dur_compliant AS DECIMAL(14, 2)) AS est_dur_compliant\n",
        "FROM v_workorder_schedule_weekly WHERE is_latest_snapshot AND schedule_week_start IS NOT NULL\n"
      ]
    },
    {
      "name": "snap_curweek",
      "displayName": "Current schedule week",
      "queryLines": [
        "SELECT priority_bucket, work_type, status, schedule_week_start, scheduled_count, schedule_compliant_count,\n",
        "       NULLIF(scheduled_count, 0) AS scheduled_count_nz\n",
        "FROM v_workorder_schedule_weekly\n",
        "WHERE is_latest_snapshot AND schedule_week_start = (SELECT max(schedule_week_start) FROM v_workorder_schedule_weekly\n",
        "                                                    WHERE is_latest_snapshot)\n"
      ]
    }
  ],
