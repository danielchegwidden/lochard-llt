{
  "datasets": [
    {
      "name": "obs",
      "displayName": "Observations",
      "queryLines": [
        "SELECT observation_id, classification, observation_type, incident_category, status, is_open,\n",
        "       potential_risk_rank, actual_risk_rank, reported_date, financial_year, financial_quarter,\n",
        "       date_format(reported_date, 'MMM') AS month, plant_area, actionee, description, days_open,\n",
        "       -- severity order for charts (AI/BI sorts categories alphabetically; leading spaces sort first and render invisibly)\n",
        "       CASE actual_risk_rank WHEN 'HIGH' THEN '   HIGH' WHEN 'MEDIUM' THEN '  MEDIUM' WHEN 'LOW' THEN ' LOW'\n",
        "            ELSE actual_risk_rank END AS risk_rank_ordered FROM v_observation_detail\n"
      ]
    },
    {
      "name": "inv",
      "displayName": "Investigations",
      "queryLines": [
        "SELECT observation_id, status, is_open, potential_risk_rank, actual_risk_rank, reported_date, financial_year,\n",
        "       financial_quarter, date_format(reported_date, 'MMM') AS month\n",
        "FROM v_observation_detail WHERE classification = 'INVESTIGATION'\n"
      ]
    },
    {
      "name": "obs_cum",
      "displayName": "Observations cumulative by month",
      "queryLines": [
        "SELECT o.observation_type, o.classification, o.incident_category, o.potential_risk_rank, o.actual_risk_rank,\n",
        "       o.financial_year, m.month_start AS as_of_month\n",
        "FROM v_observation_detail o\n",
        "JOIN (SELECT explode(sequence(DATE'2025-05-01', trunc(current_date(), 'MM'), INTERVAL 1 MONTH)) AS month_start) m\n",
        "  ON o.reported_date < add_months(m.month_start, 1)\n"
      ]
    }
  ],
